@startuml
!theme plain
skinparam {
  BackgroundColor #FFFFFF
  ClassBackgroundColor #F8F9FA
  ClassBorderColor #007ACC
  ArrowColor #0056B3
  SequenceLifeLineBackgroundColor #F5F5F5
  SequenceActorBackgroundColor #E3F2FD
  PackageBackgroundColor #E8F5E8
  PackageBorderColor #43B581
  TitleBackgroundColor #007ACC
  TitleBorderColor #007ACC
  TitleFontColor #FFFFFF
  NoteBackgroundColor #FFF9C4
  NoteBorderColor #FFD54F
  LegendBackgroundColor #F5F5F5
  FontColor #333333
  FontSize 12
}

skinparam rectangle {
  BackgroundColor #F8F9FA
  BorderColor #007ACC
  RoundCorner 10
}

title "测试报告生成流程"

rectangle "数据收集" {
  [Locust统计数据] as stats
  [请求历史数据] as history
  [错误信息统计] as errors
  [测试配置信息] as config
}

rectangle "数据处理" {
  [数据聚合器] as aggregator
  [性能指标计算] as metrics
  [图表生成] as charts
}

rectangle "报告生成" {
  [HTML模板渲染] as template
  [交互式组件] as interactive
}

rectangle "输出结果" {
  [主仪表板报告] as main_dashboard
  [场景详细报告] as scenario_reports
  [图表文件] as chart_images
}

stats --> aggregator : 原始数据
history --> aggregator : 时间序列
errors --> aggregator : 错误详情
config --> aggregator : 测试配置

aggregator --> metrics : 聚合数据
metrics --> charts : 性能指标
charts --> template : 可视化数据

template --> interactive : 渲染组件
template --> main_dashboard : 综合报告
template --> scenario_reports : 分场景报告
template --> chart_images : 图表文件

note right of aggregator
  计算关键性能指标
  格式化显示数据
  生成统计图表
end note

note left of template
  使用Jinja2模板引擎
  毛玻璃设计效果
  响应式布局设计
end note
@enduml